<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg_reversed">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="#1bb8f6"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:contentInsetStartWithNavigation="0dp"
        app:contentInsetStart="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackNav"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:layout_marginBottom="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:padding="6dp"
            android:src="@drawable/ic_back_chevron"
            android:tint="@color/surface" />

        <TextView
            android:id="@+id/tvToolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            style="@style/TextAppearance.FrauduLens.Title"
            android:includeFontPadding="true"
            android:minHeight="24dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="Sign-in"
            android:textColor="@color/surface" />
    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/keypadContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.FrauduLens.Title"
                android:text="Enter your PIN"
                android:textColor="@color/surface"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="40dp"/>

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Enter your 4-digit PIN to continue"
                android:textColor="@color/surface"
                android:textSize="14sp"
                android:alpha="0.9"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/tvTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <LinearLayout
                android:id="@+id/llPinInputs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="32dp"
                app:layout_constraintTop_toBottomOf="@id/tvDescription"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin1"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                android:background="@drawable/rounded_card_transparent"
                    android:textColor="@color/textPrimary"
                    android:layout_marginEnd="8dp"/>

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin2"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                android:background="@drawable/rounded_card_transparent"
                    android:textColor="@color/textPrimary"
                    android:layout_marginEnd="8dp"/>

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin3"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                android:background="@drawable/rounded_card_transparent"
                    android:textColor="@color/textPrimary"
                    android:layout_marginEnd="8dp"/>

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPin4"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:maxLength="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                android:background="@drawable/rounded_card_transparent"
                    android:textColor="@color/textPrimary"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPin"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:text="Continue"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                app:cornerRadius="12dp"
                android:backgroundTint="#2f08F1"
                android:textColor="@color/surface"
                style="@style/Widget.MaterialComponents.Button"
                app:layout_constraintTop_toBottomOf="@id/llPinInputs"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorLightPurple"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:maxWidth="@dimen/form_field_max_width"
            android:alignmentMode="alignMargins"
            android:columnCount="3"
            android:rowCount="4">

            <Button
                android:id="@+id/btn1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="1"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="2"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn3"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="3"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn4"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="4"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn5"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="5"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn6"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="6"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn7"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="7"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn8"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="8"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn9"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="9"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp" />

            <Button
                android:id="@+id/btn0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@color/white"
                android:text="0"
                android:textColor="@color/colorPurple"
                android:textSize="20sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                app:strokeColor="@color/colorPurple"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btnBackspace"
                android:layout_width="0dp"
                android:layout_height="70dp"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                android:backgroundTint="@android:color/transparent"
                android:elevation="0dp"
                android:stateListAnimator="@null"
                android:text=""
                android:contentDescription="Backspace"
                app:icon="@drawable/ic_backspace"
                app:iconTint="@color/colorPurple"
                app:iconSize="22dp"
                app:cornerRadius="12dp" />

        </GridLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
