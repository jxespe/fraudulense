<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg_reversed"
    android:padding="16dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitXY"
            android:src="@drawable/flbg"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPremium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            style="@style/TextAppearance.FrauduLens.Title"
            android:text="Premium"
            android:textColor="@color/surface"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgLogo" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.FrauduLens.Title"
            android:text="Select your plan"
            android:textColor="@color/surface"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/tvPremium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Tired of ads? Unlock Fraudulens Premium and get all additional features."
            android:textColor="@color/surface"
            android:textSize="13sp"
            android:alpha="0.9"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/cardPlans"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tvDescription"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn1Month"
                    android:layout_width="300dp"
                    android:layout_height="70dp"
                    android:text="1 MONTH                    PHP 349.00"
                    android:textColor="@color/surface"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/secondaryColor"
                    app:cornerRadius="6dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginBottom="1dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn6Months"
                    android:layout_width="300dp"
                    android:layout_height="70dp"
                    android:text="6 MONTHS                  PHP 999.00"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface"
                    app:cornerRadius="6dp"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_marginBottom="1dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn1Year"
                    android:layout_width="300dp"
                    android:layout_height="70dp"
                    android:text="1 YEAR                      PHP 1,599.00"
                    android:textColor="@color/textPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/surface"
                    app:cornerRadius="6dp"
                    style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFreeTrial"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:text="Start 7-Day Free Trial"
            android:textColor="@color/surface"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#271589"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_marginTop="5dp"
            app:layout_constraintTop_toBottomOf="@id/cardPlans"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Restore Purchase"
            android:textColor="@color/surface"
            android:textSize="12sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/btnFreeTrial"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvTerms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Term of Use and Privacy Policy"
            android:textColor="@color/surface"
            android:textSize="12sp"
            android:padding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvRestore"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/tvFinePrint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Your Premium subscription will be charged your selected account and renew automatically unless canceled at least 24 hours prior to the end of the subscription period at the same price and subscription type you previously purchased. Subscriptions can be manage through your account."
            android:textColor="@color/surface"
            android:textSize="10sp"
            android:alpha="0.7"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvTerms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
