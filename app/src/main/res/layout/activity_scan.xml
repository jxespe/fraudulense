<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/bgEnd"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.ScanActivity">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="Scan Message"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primaryColor" />

        <com.google.android.material.card.MaterialCardView
            android:layout_marginTop="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Paste message or link here">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMessage"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/detect"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/secondaryColor" />

                <!-- Result card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResult"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/tvResultTitle"
                            android:text="Result"
                            android:textStyle="bold"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvResultSummary"
                            android:text="Detected: Potential Scam"
                            android:layout_marginTop="6dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReportFromScan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/report"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/secondaryColor" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
