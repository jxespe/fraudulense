<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/secondaryColor"
    app:strokeWidth="1dp"
    android:background="@color/surface">

    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Target (phone number or entity) -->
        <TextView
            android:id="@+id/tvTarget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0917-XXX-XXXX"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/textPrimary"
            tools:text="0917-824-1234" />

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="From: Unknown"
            android:textColor="@color/mutedText"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="From: GCash" />

        <TextView
            android:id="@+id/tvReporter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reported by: John"
            android:textColor="@color/mutedText"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Reported by: John" />

        <ImageView
            android:id="@+id/imgReport"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:scaleType="centerCrop"
            android:background="@color/colorLightPurple"
            android:visibility="gone"
            tools:visibility="visible"
            tools:src="@drawable/sample_post" />

        <!-- Summary -->
        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sent phishing link asking for OTP"
            android:textColor="@color/mutedText"
            android:textSize="14sp"
            tools:text="Reported fake GCash link" />

        <!-- Status + Timestamp Row -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Open"
                android:textStyle="bold"
                android:textColor="@color/secondaryColor"
                android:textSize="14sp"
                tools:text="Open" />

            <TextView
                android:id="@+id/tvTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2h ago"
                android:textColor="@color/mutedText"
                android:textSize="13sp"
                tools:text="2h ago" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
