<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FrauduLens" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorSecondary">@color/secondaryColor</item>
        <item name="android:statusBarColor">@color/primaryVariant</item>
        <item name="android:navigationBarColor">@color/primaryVariant</item>
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
        <item name="materialCardViewStyle">@style/Widget.MaterialComponents.CardView</item>
        <item name="android:windowBackground">@drawable/gradient_bg</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="FrauduLens.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="titleTextAppearance">@style/FrauduLens.Toolbar.Title</item>
    </style>

    <style name="FrauduLens.Toolbar.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/surface</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="FrauduLens.SlideUpDialog" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowAnimationStyle">@style/FrauduLens.SlideUpDialog.Animation</item>
        <item name="android:windowBackground">@color/surface</item>
    </style>

    <style name="FrauduLens.SlideUpDialog.Animation">
        <item name="android:windowEnterAnimation">@anim/slide_up</item>
        <item name="android:windowExitAnimation">@anim/slide_down</item>
    </style>

    <!-- Font Styles -->
    <!-- Base League Spartan text appearance -->
    <style name="TextAppearance.LeagueSpartan" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/league_spartan</item>
    </style>

    <!-- Bold League Spartan text appearance -->
    <style name="TextAppearance.LeagueSpartan.Bold" parent="@style/TextAppearance.LeagueSpartan">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Roboto text appearance -->
    <style name="TextAppearance.Roboto" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.FrauduLens.Title" parent="@android:style/TextAppearance">
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="ShapeAppearanceOverlay.MaterialComponents.Circular" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearanceOverlay.FrauduLens.ProfileTopConnected" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">20dp</item>
        <item name="cornerSizeBottomRight">20dp</item>
    </style>
</resources>
