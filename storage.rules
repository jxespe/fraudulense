rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /posts/{allPaths=**} {
      allow read, write: if true;
    }
    match /reports/{allPaths=**} {
      allow read, write: if true;
    }
    match /profile/{allPaths=**} {
      allow read, write: if true;
    }
  }
}
